meta {
  name: 15 Actualizar paciente
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/api/pacientes/{{pacienteId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tipoDocumento": "DEMO",
    "numeroDocumento": "{{documento}}",
    "nombres": "Paciente Actualizado",
    "apellidos": "Ficticio",
    "fechaNacimiento": "2000-01-01",
    "telefono": "DEMO-0001",
    "correo": "prueba@example.invalid",
    "direccion": "Direccion de prueba",
    "estado": "INACTIVO"
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
