meta {
  name: 08 Confirmar cita
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/citas/{{citaId}}/estado
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "estado": "CONFIRMADA"
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Estado CONFIRMADA", function () {
    expect(res.getBody().estado).to.equal("CONFIRMADA");
  });
}
